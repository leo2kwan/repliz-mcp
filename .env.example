# ─── Repliz API ─────────────────────────────────────────────────────────────
# Base URL of the Repliz Public API (optional — defaults to https://api.repliz.com)
REPLIZ_BASE_URL=https://api.repliz.com

# ─── Credentials (HTTP Basic Auth) ──────────────────────────────────────────
# Access Key = username, Secret Key = password.
# Get these from your Repliz workspace settings (Developer / API).
#
# Required for stdio (local) mode.
# In HTTP (remote) mode these are OPTIONAL: if set, they act as a fallback for
# single-tenant hosting; otherwise each user supplies their own via headers.
REPLIZ_ACCESS_KEY=your_access_key_here
REPLIZ_SECRET_KEY=your_secret_key_here

# ─── Transport (remote mode only) ───────────────────────────────────────────
# Leave unset for local stdio mode. Set to "http" to run the remote
# Streamable HTTP server (or start with: npm run start:http).
# REPLIZ_TRANSPORT=http
# PORT=3000
