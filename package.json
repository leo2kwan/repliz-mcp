{
  "name": "repliz-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for the Repliz Public API — manage accounts, comments, scheduled posts, chats, content, research, and add-ons from any MCP-compatible AI client.",
  "type": "module",
  "bin": {
    "repliz-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "node --import tsx src/index.ts",
    "dev:http": "node --import tsx src/index.ts --http",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "repliz",
    "social-media",
    "automation",
    "ai",
    "claude"
  ],
  "author": "Repliz",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.21",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
